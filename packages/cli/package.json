    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "eslint": "10.0.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  }
