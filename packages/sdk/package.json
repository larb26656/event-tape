{
  "name": "@event-tape/sdk",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Event Tape Recorder SDK",
  "engines": { "node": ">=22" },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@event-tape/recording-format": "workspace:*",
    "tsdown": "0.23.7",
    "typescript": "6.0.2",
    "eslint": "10.0.1",
    "vitest": "4.1.0",
    "@types/node": "22.19.15"
  }
}
