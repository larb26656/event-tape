{
  "name": "event-tape",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm dev:player",
    "dev:player": "pnpm --filter @event-tape/player dev",
    "dev:cli": "pnpm --filter @event-tape/cli... build && node packages/cli/dist/cli.mjs",
    "view:sample": "pnpm --filter @event-tape/cli... build && node packages/cli/dist/cli.mjs view ./sample-recording.jsonl",
    "local:build:cli": "pnpm --filter @event-tape/cli... build && bin_dir=\"$(pnpm bin --global)\" && mkdir -p \"$bin_dir\" && ln -sf \"$PWD/packages/cli/dist/cli.mjs\" \"$bin_dir/event-tape\"",
    "local:build:sdk": "pnpm --filter @event-tape/sdk... build && pnpm --filter @event-tape/sdk pack --out \"$PWD/event-tape-sdk.tgz\" && printf '\\nInstall in your project:\\n  npm install \"%s/event-tape-sdk.tgz\"\\n' \"$PWD\"",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --continue=always",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10",
    "typescript": "6.0.2",
    "typescript-eslint": "8.56.0"
  }
}
